{erl_opts, [debug_info]}.

%% Xref configuration - ignore unused exports (these are public API)
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

%% Dialyzer configuration
{dialyzer, [
    {warnings, [
        unmatched_returns,
        error_handling
    ]},
    {plt_extra_apps, [livery, ws]}
]}.

{deps, [
    {livery, "~> 0.9.2"},
    %% Fork fixes livery's hex releases lack: bounded sends and abort in
    %% ws_session, and no server idle timeout during streaming responses.
    {ws, {git, "https://github.com/h0rv/erlang-ws.git",
          {ref, "09bea3e650187aaeeaba1a8c734338bdeedfe136"}}},
    {h1, {git, "https://github.com/h0rv/erlang-h1.git",
          {ref, "c5d847cc9dd74fa2acda0a6ba629a4c97438dcfa"}}},
    %% Fork main: native-only channel receive and task supervision used by priv/.
    {erlang_python, {git, "https://github.com/h0rv/erlang-python.git",
                     {ref, "71b35223f89f589d535eaf261dd955428dcb042f"}}}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [hornbeam]}
]}.

{relx, [{release, {hornbeam, "1.4.1"},
         [hornbeam,
          sasl]},

        {mode, dev},

        {extended_start_script, true}]}.

{profiles, [
    {test, [
        {deps, [
            {jsx, "3.1.0"}
        ]}
    ]}
]}.

{project_plugins, [rebar3_ex_doc]}.

{hex, [{doc, ex_doc}]}.

{ex_doc, [
    {source_url, <<"https://github.com/benoitc/hornbeam">>},
    {homepage_url, <<"https://hornbeam.dev">>},
    {main, <<"readme">>},
    {extras, [
        <<"README.md">>,
        <<"CHANGELOG.md">>
    ]}
]}.
